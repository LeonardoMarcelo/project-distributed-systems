# Copie para `.env` se alguma porta padrao estiver ocupada na sua maquina.
# O compose le `.env` automaticamente. Nenhum segredo vive aqui — o MiniGrid
# nao tem credencial propria; o RabbitMQ usa o guest/guest padrao, de propósito,
# porque o sistema nao e exposto fora da maquina.
MINIGRID_DASHBOARD_PORT=8080
MINIGRID_CONSUL_PORT=8500
MINIGRID_RABBIT_UI_PORT=15672
MINIGRID_AMQP_PORT=5672
MINIGRID_STOMP_PORT=61613
MINIGRID_COORD1_PORT=50051
MINIGRID_COORD2_PORT=50052
